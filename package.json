{
  "name": "byte-breaker",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview --host 127.0.0.1",
    "test:sql": "node --experimental-strip-types --test tests/sqlSimulation.test.ts",
    "test:labs": "node --experimental-strip-types --test tests/labSimulation.test.ts",
    "test:feedback": "node --experimental-strip-types --test tests/failureFeedback.test.ts",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:ui": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.2.0"
  }
}
